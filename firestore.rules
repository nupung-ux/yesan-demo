rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 이 앱(익명 로그인)으로 접속한 경우에만 읽고 쓸 수 있습니다.
    match /schools/{school} {
      allow read, write: if request.auth != null;
    }
    match /schools/{school}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
